# dsh on the HarmonyOS PC (harmonybrew): the standard deployment as a package.
#
# The bottle is built on the build VM by scripts/openharmony/pack-bottle.sh from a pack-tree.sh tree, a make-node.sh
# node and the default-root launchers of scripts/openharmony/deploy.sh. Pouring it replaces the deployed tree in
# /data/storage/el2/base/dsh in place — the ~/.zshrc PATH block keeps pointing there — and the payload deployer
# verifies the new tree before the old one goes. Homebrew owns the version; the root keeps owning the running copy.
class Dsh < Formula
  desc "DeepSeek Harness CLI and Web UI for the HarmonyOS PC"
  homepage "http://127.0.0.1:3000/nan/deepseek-harness"
  version "@VERSION@"
  url "@PAYLOAD_URL@"
  sha256 "@PAYLOAD_SHA@"
  license "MIT"

  # Poured from the bottle pack-bottle.sh assembles and signs on the build VM and pushes to the device: harmonybrew
  # on the PC has no C compiler, so it refuses a source build even though nothing is compiled.
  bottle do
    root_url "@BOTTLE_URL@"
    sha256 cellar: :any_skip_relocation, arm64_ohos: "@BOTTLE_SHA@"
  end

  def dsh_root
    Pathname("@ROOT@")
  end

  def install
    # A source install receives the payload archive itself; keep it and its deployer for post_install.
    libexec.install "deploy-payload.sh"
    system "tar", "-czf", libexec/"dsh-payload.tar.gz", "tree", "node", "bin", "VERSION", "deploy-payload.sh"
  end

  def post_install
    system libexec/"deploy-payload.sh", libexec/"dsh-payload.tar.gz", dsh_root.to_s
  end

  def caveats
    <<~EOS
      dsh runs from #{dsh_root} (the standard deployment root), which this package replaces in place:
        dsh --version      # prints #{version}
        dsh-web            # serves the Web UI on 127.0.0.1:3080 and opens it in the device browser
      `brew uninstall dsh` keeps that root: it holds dsh's state paths and the PATH block in ~/.zshrc.
    EOS
  end

  test do
    assert_match version.to_s, shell_output("#{dsh_root}/bin/dsh --version")
  end
end
